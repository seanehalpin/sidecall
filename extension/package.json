{
  "name": "sidecall-extension",
  "description": "Sidecall Chrome extension: side rail, service worker and (later) picker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "gen:protocol": "node scripts/gen-protocol.mjs",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "wxt build && vitest run -c vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/ws": "^8.18.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "json-schema-to-typescript": "^16.0.0",
    "playwright": "1.63.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "5.9.3",
    "vitest": "^5.0.3",
    "ws": "^8.22.0",
    "wxt": "^0.21.4"
  }
}
